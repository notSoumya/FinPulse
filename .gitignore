
# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Code quality
.ruff_cache/
.mypy_cache/

# Logs
*.log
logs/

# Generated data
data/generated/*
!data/generated/.gitkeep

data/lake/*
!data/lake/.gitkeep

data/warehouse/*
!data/warehouse/.gitkeep

data/synthetic/bronze/
data/synthetic/silver/
data/synthetic/checkpoints/
data/synthetic/quarantine/
data/synthetic/warehouse/

# Credentials
credentials/
secrets/
*.pem
*.key
service-account*.json

# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/
# Allow profiles.yml for zero-cost local DuckDB
!dbt/profiles.yml
dbt/.user.yml

# Airflow
airflow/logs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Archives and local datasets
_archive/
Customer_financial_profiles.csv

# Generated by pip install -e
*.egg-info/

# Sample data (may contain real personal info)
data/raw_samples/