
# ==================================
# FinPulse Environment Configuration
# ==================================

# Application
APP_NAME=FinPulse
APP_ENV=development
DEBUG=true

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

KAFKA_TOPIC_BANK_SMS=raw.bank.sms
KAFKA_TOPIC_UPI_CSV=raw.upi.csv
KAFKA_TOPIC_CARD_PDF=raw.card.pdf
KAFKA_TOPIC_MANUAL=raw.manual

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=finpulse-bronze
MINIO_SECURE=false

# Google BigQuery
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=finpulse_gold
GOOGLE_APPLICATION_CREDENTIALS=

# PostgreSQL (Airflow metadata)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me

# Logging
LOG_LEVEL=INFO
